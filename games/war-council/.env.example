# Copy to .env (git-ignored) and fill in. Never commit real keys.
LLM_API_KEY=
LLM_BASE_URL=https://api.subq.ai/v1
LLM_MODEL=subq-snap-preview
# llm = always use the model (show failures), auto = fall back to rules on failure, heuristic = rules only
BRAIN_MODE=auto
PORT=8787
TICK_MS=1000
# Send a rendered battlefield PNG with every decision (0 to disable)
LLM_IMAGES=1
